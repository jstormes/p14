#!/bin/bash
# llm3 (Radeon 780M / gfx1103, Phoenix RDNA3) switchable variant launcher.
# Flags mirror llama-qwen3.6-35b-q8.service exactly so the control arm == production.
set -eu
. /etc/llama-variant.env
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
[ -n "${VK_ICD_FILENAMES:-}" ] && export VK_ICD_FILENAMES VK_DRIVER_FILES
export RADV_PERFTEST="${RADV_PERFTEST:-nogttspill}"
DEV="${LLAMA_DEV:-Vulkan0}"
SPEC="${LLAMA_SPEC:---spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-type-k q8_0 --spec-draft-type-v q8_0}"
echo "llama-launch: variant=${LLAMA_VARIANT} dev=${DEV} bin=${LLAMA_BIN}"
echo "llama-launch: LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-<unset>} VK_ICD=${VK_ICD_FILENAMES:-<system>}"
exec "$LLAMA_BIN" \
  --host 0.0.0.0 --port 8080 \
  -m /mnt/data/models/Qwen3.6-35B-A3B-Q8/Qwen3.6-35B-A3B-Q8_0.gguf \
  --mmproj /mnt/data/models/Qwen3.6-35B-A3B-Q8/mmproj-BF16.gguf \
  --alias Qwen3.6-35B-A3B-Q8-780M \
  -ngl 999 --fit off --no-mmap \
  --cache-ram 8192 --cache-reuse 256 \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  -c 262144 -b 8192 -ub 2048 -np 2 -fa 1 -kvu \
  $SPEC \
  --image-min-tokens 1024 \
  --jinja --reasoning-budget 2048 \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 1.5 \
  -dev "$DEV"
