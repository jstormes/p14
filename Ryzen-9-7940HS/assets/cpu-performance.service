[Unit]
Description=CPU/GPU performance mode + gate GPU readiness for llama units

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 10
ExecStart=/bin/bash -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g" 2>/dev/null; done; for d in /sys/class/drm/card*/device/power_dpm_force_performance_level; do echo high > "$d" 2>/dev/null; done; true'

[Install]
WantedBy=multi-user.target
