# strix-halo-llamacpp v0.2 on SYSTEM Mesa 26.1.5.
# Tests whether the fixes generalise from gfx1151 (RDNA3.5) to gfx1103 (RDNA3).
# On the P16s (gfx1150) sys and bundled were within 1%, so this is the arm that matters.
LLAMA_VARIANT=toolbox-sys
LLAMA_BIN=/opt/llama/strix-toolbox/vulkan/bin/llama-server
LD_LIBRARY_PATH=/opt/llama/strix-toolbox/vulkan/bin
