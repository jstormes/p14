[Unit]
Description=llama.cpp Server (Vulkan) - Qwen3.6-35B-A3B Q8_0 + MTP spec-decode n-max 2 (vision, 3x256K) [llm3]
After=network.target cpu-performance.service

[Service]
Type=simple
Environment=RADV_PERFTEST=nogttspill
WorkingDirectory=/opt/llama/llama.cpp-b10173
SupplementaryGroups=render video
ExecStart=/opt/llama/llama.cpp-b10173/build/bin/llama-server \
  --host 0.0.0.0 \
  --port 8080 \
  -m /mnt/data/models/Qwen3.6-35B-A3B-Q8/Qwen3.6-35B-A3B-Q8_0.gguf \
  --mmproj /mnt/data/models/Qwen3.6-35B-A3B-Q8/mmproj-BF16.gguf \
  --alias Qwen3.6-35B-A3B-Q8-780M \
  -ngl 999 \
  --fit off \
  --no-mmap \
  --cache-ram 8192 \
  --cache-reuse 256 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  -c 262144 \
  -b 8192 \
  -ub 2048 \
  -np 1 \
  -fa 1 \
  --spec-type draft-mtp \
  --spec-draft-n-max 2 \
  --spec-draft-type-k q8_0 \
  --spec-draft-type-v q8_0 \
  --image-min-tokens 1024 \
  --jinja --reasoning-budget 2048 \
  --temp 1.0 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 1.5 \
  -dev Vulkan0

Restart=on-failure
RestartSec=10
LimitMEMLOCK=infinity
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
